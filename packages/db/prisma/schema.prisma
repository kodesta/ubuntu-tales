// Ubuntu Tales — Phase 1 read path + Phase 2 accounts (see docs/production-plan/02 §3 and
// DEVIATIONS.md 0.4 / Phase 2 notes).
//
// Phase 1 modelled the public catalogue: categories, tribes, narrators, stories and the editorial
// story-of-the-day. Phase 2 (migration `phase2_accounts`) adds identity (`User`, `RefreshToken`,
// `EmailToken`, `UserConsent`), stats and the personal activity tables (`SavedStory`,
// `ReadingProgress`, `Reaction`). Submissions and media tables remain deferred to their phases;
// additive fields and tables are allowed when a later task needs them.
//
// Images are served as root-relative static paths in Phase 1 (`/covers/*.svg`); the plan's
// MediaAsset/RustFS pipeline returns in Phase 3. Fields are named `*Url` so a media-asset
// migration can add asset relations alongside them without a breaking rename.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum Region {
  NORTH_AFRICA
  WEST_AFRICA
  CENTRAL_AFRICA
  EAST_AFRICA
  SOUTHERN_AFRICA
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessLevel {
  FREE
  PREMIUM
}

enum ReactionType {
  JOY
  GREAT
  GOOD
  THINKING
  HAPPY
}

/// Permissions role (ADR-008: never derive this from `communityRole`).
enum SystemRole {
  READER
  CONTRIBUTOR
  EDITOR
  ADMIN
}

enum CommunityRole {
  STORYTELLER
  SEEKER
  WRITER
  STORYTELLER_AND_SEEKER
  ELDER_GUARDIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ───────────── Catalogue ─────────────

/// A tribe / people. Presented as a "publication" in the Substack-inspired UI.
model Tribe {
  id                  String   @id @default(uuid(7)) @db.Uuid
  slug                String   @unique
  name                String   @unique
  region              Region
  countries           String[] @default([])
  countriesLabel      String
  tagline             String?  @db.VarChar(200)
  description         String?
  accentColor         String   @db.VarChar(7)
  themeVariant        String?
  /// Publication mark (static SVG until the media pipeline exists).
  imageUrl            String?
  imageAlt            String?
  imageAccent         String?  @db.VarChar(7)
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  /// Presentation-only follower count.
  subscriberCount     Int      @default(0)
  /// Denormalised; recomputed by the seed (and on publish/unpublish in later phases).
  publishedStoryCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stories Story[]

  users User[]

  @@index([region, isActive])
  @@index([isActive, sortOrder])
}

model Category {
  id        String  @id @default(uuid(7)) @db.Uuid
  slug      String  @unique
  name      String
  badge     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  stories Story[]

  @@index([isActive, sortOrder])
}

/// A griot / narrator — the "author" of a tale in the editorial experience.
model Narrator {
  id           String   @id @default(uuid(7)) @db.Uuid
  slug         String   @unique
  name         String
  bio          String?
  roleLabel    String?
  accentColor  String?  @db.VarChar(7)
  avatarUrl    String?
  avatarAlt    String?
  avatarAccent String?  @db.VarChar(7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stories Story[]
}

model Story {
  id              String      @id @default(uuid(7)) @db.Uuid
  slug            String      @unique
  locale          String      @default("en") @db.VarChar(10)
  title           String      @db.VarChar(160)
  summary         String      @db.VarChar(400)
  moral           String?     @db.VarChar(300)
  /// Structured body: { version: 1, paragraphs: [{ id, sentences: [{ id, text }] }] } (ADR-011).
  body            Json
  wordCount       Int
  readTimeMinutes Int
  tribeId         String      @db.Uuid
  categoryId      String      @db.Uuid
  narratorId      String?     @db.Uuid
  /// Display override, e.g. "IGBO, NIGERIA"; falls back to the tribe region label.
  regionLabel     String?
  coverUrl        String
  coverAlt        String
  coverAccent     String      @db.VarChar(7)
  attribution     String?
  /// The read-path slice only seeds published content; DRAFT is used by the admin console later.
  status          StoryStatus @default(PUBLISHED)
  accessLevel     AccessLevel @default(FREE)
  isFeatured      Boolean     @default(false)
  publishedAt     DateTime?
  popularityScore Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tribe   Tribe     @relation(fields: [tribeId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  narrator Narrator? @relation(fields: [narratorId], references: [id])
  featuredOn StoryOfTheDay[]

  saved    SavedStory[]
  progress ReadingProgress[]
  reactions Reaction[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, popularityScore(sort: Desc)])
  @@index([status, title])
  @@index([tribeId, status])
  @@index([categoryId, status])
  @@index([narratorId, status])
  @@index([locale, status])
}

model StoryOfTheDay {
  id      String   @id @default(uuid(7)) @db.Uuid
  date    DateTime @db.Date
  locale  String   @default("en") @db.VarChar(10)
  storyId String   @db.Uuid

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([date, locale])
  @@index([storyId])
}

// ───────────── Identity & accounts (Phase 2) ─────────────

/// A reader account. Email uniqueness is case-insensitive (`citext`). Deleting a user is a soft
/// delete (`status = DELETED`, `deletedAt`) so published attribution and audit trails survive;
/// personal activity rows cascade from the relation.
model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  email           String         @unique @db.Citext
  emailVerifiedAt DateTime?
  passwordHash    String?
  displayName     String         @db.VarChar(80)
  /// Optional, sensitive personalisation data (POPIA/GDPR special category) collected with consent.
  tribeId         String?        @db.Uuid
  customLineage   String?        @db.VarChar(120)
  lineageLabel    String?        @db.VarChar(160)
  communityRole   CommunityRole?
  systemRole      SystemRole     @default(READER)
  status          UserStatus     @default(ACTIVE)
  /// Bumped on logout-all / password reset / suspension; the access-token `sv` claim must match.
  sessionVersion  Int            @default(0)
  locale          String         @default("en") @db.VarChar(10)
  onboardedAt     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tribe         Tribe?            @relation(fields: [tribeId], references: [id])
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  consents      UserConsent[]
  stats         UserStats?
  saved         SavedStory[]
  progress      ReadingProgress[]
  reactions     Reaction[]

  @@index([tribeId])
  @@index([status])
}

/// A rotating session. The raw opaque token lives only in the httpOnly cookie; the database stores
/// `sha256(token)` so a database leak cannot be replayed.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// All descendants of one login share a family id; reuse detection revokes the whole family.
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ip           String?   @db.Inet
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Single-use, hashed email tokens for verification (24 h) and password reset (30 min).
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/// Consent records with policy version (POPIA/NDPA/Kenya DPA/GDPR evidence).
model UserConsent {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  /// "terms" | "privacy" | "lineage_personalisation" | "analytics" | "marketing_email"
  type      String
  version   String
  granted   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Denormalised gamification counters; always updated in the same transaction as the activity row.
model UserStats {
  userId            String    @id @db.Uuid
  /// Distinct stories completed.
  talesRead         Int       @default(0)
  /// Distinct tribes of completed stories, plus the user's own tribe.
  tribesExplored    Int       @default(0)
  listeningSeconds  Int       @default(0)
  currentStreakDays Int       @default(0)
  /// Activity day used for the streak (YYYY-MM-DD in the request timezone).
  lastActiveDay     DateTime? @db.Date
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Personal activity (Phase 2) ─────────────

model SavedStory {
  userId    String   @db.Uuid
  storyId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([storyId])
}

model ReadingProgress {
  userId          String    @db.Uuid
  storyId         String    @db.Uuid
  narrationId     String?   @db.Uuid
  lastSentenceId  String?
  audioPositionMs Int       @default(0)
  /// 0..100, clamped server-side.
  percent         Int       @default(0)
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  completionCount Int       @default(0)
  /// Client clock of the last accepted write, for offline last-write-wins.
  clientUpdatedAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([storyId])
}

model Reaction {
  userId    String       @db.Uuid
  storyId   String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId, type])
  @@index([userId])
}
