# ─── API ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4100
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://ubuntu_tales:ubuntu_tales@localhost:5433/ubuntu_tales?schema=public"

# ─── Web (Vite, public values only) ─────────────────────────────────────
VITE_API_URL=/api/v1

# ─── Dev seed ────────────────────────────────────────────────────────────
SEED_DEV_PASSWORD=ubuntu-tales-dev

# ─── Phase 2: auth sessions ─────────────────────────────────────────────
# Dev-only secret. Generate a 64-byte random value for any real environment.
JWT_SECRET=dev-only-ubuntu-tales-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
HIBP_ENABLED=true

# ─── Phase 2: email (Mailpit in dev; any SMTP provider in prod) ────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ubuntu Tales <hello@ubuntutales.local>"
# When unset, emails are logged to the API console instead of sent.
EMAIL_LOG_ONLY=false
