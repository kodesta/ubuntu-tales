# syntax=docker/dockerfile:1
# API image — multi-stage, non-root, read-only friendly (production plan 07 §3).

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/api-client/package.json packages/api-client/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @ubuntu-tales/api... --filter @ubuntu-tales/db...

FROM deps AS build
COPY . .
RUN pnpm --filter @ubuntu-tales/shared build \
 && pnpm --filter @ubuntu-tales/db build \
 && pnpm --filter api build \
 && pnpm deploy --filter @ubuntu-tales/api --prod /app

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
RUN mkdir -p /data/media && chown -R node:node /data/media
USER node
ENV MEDIA_ROOT=/data/media
ENV API_PORT=4100
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4100/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main.js"]
